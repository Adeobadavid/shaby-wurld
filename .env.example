
# --- Order notification email (Resend) -----------------------------------
# Without these, a paid order notifies nobody — the webhook only logs it.
# RESEND_API_KEY is a secret: it belongs in .dev.vars locally and in
# `wrangler secret put` for production, never in this file's real counterpart.
RESEND_API_KEY=
# Where order notifications are delivered.
ORDER_EMAIL_TO=shabywurld@gmail.com
# Must be on a domain verified in Resend, or delivery is refused.
ORDER_EMAIL_FROM=Shaby Wurld <orders@shabywurld.com>
